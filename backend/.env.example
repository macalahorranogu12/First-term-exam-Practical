# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (RDS)
# ==========================================
# Ejemplo para PostgreSQL en RDS:
DATABASE_URL=postgresql://postgres:password@tu-endpoint-rds:5432/videodb

# ==========================================
# CONFIGURACIÓN DE AMAZON S3
# ==========================================
AWS_REGION=us-east-1
S3_BUCKET_VIDEOS=nombre-del-bucket-videos
S3_BUCKET_THUMBNAILS=nombre-del-bucket-miniaturas
